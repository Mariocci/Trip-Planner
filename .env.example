# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_change_this_in_production

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database Configuration (already in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripplanner
DB_USER=tripplanner_user
DB_PASSWORD=tripplanner_pass
